{
  // Esempio innocuo: crea cartelle e stampa il nome di ogni file. Provarlo prima con --dry-run.
  "variables": {
    "RootDir": "C:\\terraform-sample",
    "SourceComputerName": "SERVER-SORGENTE",
    "BatchPassword": "DA-SOSTITUIRE"
  },
  "pipeline": [
    {
      "id": "step_01_folders",
      "name": "Crea struttura cartelle",
      "type": "REQUIRED-FOLDERS",
      "enabled": true,
      "config": {
        "paths": ["{RootDir}\\in", "{RootDir}\\out"]
      }
    },
    {
      "id": "step_02_list_files",
      "name": "Elenca i file .dll",
      "type": "FILE-BATCH-PROCESS",
      "enabled": true,
      "config": {
        "searchPaths": ["{RootDir}\\in"],
        "recurse": true,
        "maxConcurrency": 4,
        "filter": {
          "pattern": "^EUR[CW].*\\.dll$",
          "matchType": "Regex",
          "ignoreCase": true
        },
        "command": "cmd.exe",
        "arguments": "/c echo {FileName} in {Directory}"
      }
    },
    {
      // Disabilitato: richiede server/account reali e privilegi amministrativi locali.
      "id": "step_03_services",
      "type": "CREATE-SERVICES",
      "enabled": false,
      "config": {
        "sourceComputerName": "{SourceComputerName}",
        "filter": { "accountPattern": "*svc_*" },
        "credentials": { "DOMINIO\\svc_batch": "{BatchPassword}" }
      }
    },
    {
      // Disabilitato: sovrascrive i task selezionati, mantenendoli disabilitati.
      "id": "step_04_tasks",
      "type": "CREATE-TASKS",
      "enabled": false,
      "config": {
        "sourceComputerName": "{SourceComputerName}",
        "filter": { "names": ["\\Batch\\Import"] },
        "credentials": { "DOMINIO\\svc_batch": "{BatchPassword}" }
      }
    }
  ]
}
